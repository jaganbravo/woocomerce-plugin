# Local Docker only — copy to `.env` in this directory and fill in.
# Compose loads `.env` automatically for ${VAR} substitution. Do not commit `.env`.
#
# Unmai Analytix for WooCommerce reads these from PHP getenv() — see:
# store-compass-for-woocommerce/includes/class-dataviz-ai-api-client.php
# After sync, the plugin folder is wp-content/plugins/unmai-analytix-for-woocommerce/
#
# Use OPENAI_API_KEY (common) or UNMAI_ANALYTIX_API_KEY (plugin-specific).
# Legacy DATAVIZ_AI_API_KEY / DATAVIZ_AI_API_BASE_URL still work.

OPENAI_API_KEY=
# UNMAI_ANALYTIX_API_KEY=
# Optional: non-default API base (OpenAI-compatible)
# UNMAI_ANALYTIX_API_BASE_URL=
